# Required: Neon dashboard > Connect > copy the "Pooled connection" string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Required: any long random text. Used to sign login sessions.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: protects GET /api/cron/reminders (for a daily scheduled call)
CRON_SECRET=

# Optional: WhatsApp Cloud API. Without these, WhatsApp messages open in one click via wa.me.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Optional: SMS gateway URL. {phone} and {message} are replaced for each message.
SMS_GATEWAY_URL=

# Optional: email sending
SMTP_URL=
EMAIL_FROM=
