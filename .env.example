# Required: Neon dashboard > Connect > copy the "Pooled connection" string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Required: any long random text. Used to sign login sessions.
JWT_SECRET=change-me-to-a-long-random-string

# Required for selling GymPilot to gyms: the key for the hidden page /superadmin, where gym accounts are created.
# Use 24 or more random characters, and keep it secret.
SUPERADMIN_KEY=

# Optional: protects GET /api/cron/reminders (for a daily scheduled call)
CRON_SECRET=

# WhatsApp Business is connected by each gym on Messages > WhatsApp setup. Without it, messages open in one click via wa.me.

# Optional: SMS gateway URL. {phone} and {message} are replaced for each message.
SMS_GATEWAY_URL=

# Optional: email sending
SMTP_URL=
EMAIL_FROM=
